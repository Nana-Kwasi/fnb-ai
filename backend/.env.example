DATABASE_URL=postgresql+asyncpg://bankaiuser:CHANGE_ME@localhost:5432/bankaidb
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-me-in-production
MODEL_PATH=/models/Phi-3-mini-4k-instruct-q4.gguf
DEBUG=false
RATE_LIMIT_PER_MINUTE=1000

# --- Production template (copy into .env for deployed API) ---
# ENVIRONMENT=production
# ENFORCE_PRODUCTION_HARDENING=true
# DEBUG=false
# SECRET_KEY=<long-random>
# STRICT_MAPPER_ENFORCEMENT=true
# STRICT_TRAINING_GOVERNANCE=true
# ALLOW_MODEL_FALLBACK=false
# ADMIN_LEGACY_TOKEN_AUTH=false
# WAREHOUSE_ISOLATION_VERIFICATION_ENABLED=true
# WAREHOUSE_ISOLATION_REQUIRE_LOCAL_TRAINING_LAYOUT=true
# CALIBRATION_ACTIVATION_REQUIRES_VALIDATION=true
# CALIBRATION_ACTIVATION_MIN_ACCURACY=0.85
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...
# PAGING_WEBHOOK_URL=https://...
# Optional: fail startup if these URLs are unset when hardening is on
# PRODUCTION_REQUIRE_ALERT_WEBHOOK=true
# PRODUCTION_REQUIRE_READ_REPLICA=true
# READ_REPLICA_DATABASE_URL=postgresql+asyncpg://readonly:...@replica/bankai
# PRODUCTION_REQUIRE_ANALYTICS_WAREHOUSE=true
# ANALYTICS_WAREHOUSE_URL=postgresql+asyncpg://...
# Phase 4 (enable only after shadow burn-in)
# SHADOW_SCORING_ENABLED=true
# AUTO_PROMOTION_ENABLED=false
# AUTO_ROLLBACK_ENABLED=false
# AUTO_ROLLBACK_MODEL_TYPES=fraud,care
# AUTO_ROLLBACK_CARE_MAX_ESCALATION_RATE=0.35
# AUTO_CUTOVER_ENABLED=false
# AUTO_CUTOVER_DRY_RUN=true
# --- end production template ---
# Optional: lock manual retrain after test-upload scores well (fraud CSV path)
# FRAUD_UPLOAD_LOCK_MIN_AUC=0.90
# FRAUD_UPLOAD_LOCK_MIN_ACC=0.93
# FRAUD_UPLOAD_LOCK_MIN_N=200
# Optional: care retrain recommendation thresholds (data-quality endpoint)
# CARE_RETRAIN_RECO_TRUST_GREEN_MIN=0.72
# CARE_RETRAIN_RECO_DUP_GREEN_MAX=0.45
# CARE_RETRAIN_RECO_TRUST_AMBER_MIN=0.52
# Optional: bootstrap admin token (hashed at runtime; merged into RBAC until revoked).
# After minting a real owner via POST /api/v1/admin/rbac/tokens/create, revoke bootstrap:
#   POST /api/v1/admin/rbac/tokens/revoke  token_id=bootstrap  (X-Admin-Token: new owner)
# See scripts/admin_rbac_bootstrap.sh
# ADMIN_WRITE_TOKEN=
# JWT platform admin (DB users). First owner is created once if DB empty and both are set:
# PLATFORM_BOOTSTRAP_OWNER_EMAIL=
# PLATFORM_BOOTSTRAP_OWNER_PASSWORD=
# ADMIN_LEGACY_TOKEN_AUTH=true
# PLATFORM_JWT_EXPIRE_MINUTES=720
# REPORT_ARTIFACT_RETENTION_DAYS=30
# STRICT_MAPPER_ENFORCEMENT=false
# STRICT_TRAINING_GOVERNANCE=false
# ALLOW_MODEL_FALLBACK=true
# MODEL_FALLBACK_ALLOWLIST_TENANTS=
# AUTO_ROLLBACK_ENABLED=false
# AUTO_ROLLBACK_MODEL_TYPES=fraud
# AUTO_ROLLBACK_WINDOW_HOURS=24
# AUTO_ROLLBACK_MIN_SCORED=300
# AUTO_ROLLBACK_MAX_BLOCK_RATE=0.6
# AUTO_ROLLBACK_MAX_ALERT_RATE=0.5
# AUTO_ROLLBACK_CARE_MAX_ESCALATION_RATE=0.45
# SHADOW_SCORING_ENABLED=false
# AUTO_PROMOTION_ENABLED=false
# AUTO_PROMOTION_WINDOW_HOURS=24
# AUTO_PROMOTION_MIN_COMPARED=300
# AUTO_PROMOTION_MAX_BLOCK_RATE_DELTA=0.02
# AUTO_PROMOTION_MAX_OTP_RATE_DELTA=0.03
# AUTO_PROMOTION_MAX_DISAGREE_RATE=0.20
# AUTO_PROMOTION_COOLDOWN_HOURS=24
# AUTO_PROMOTION_CANDIDATE_MIN_AGE_HOURS=6
# AUTO_PROMOTION_MIN_LABELED=100
# AUTO_PROMOTION_MIN_PRECISION_DELTA=-0.01
# AUTO_CUTOVER_ENABLED=false
# AUTO_CUTOVER_DRY_RUN=true
# AUTO_CUTOVER_REQUIRE_NO_PRIOR_EXECUTION=true
# AUTO_CUTOVER_MODEL_TYPES=fraud,care
# Ops alerts — JSON POST: {"event_type","severity","timestamp","payload"}
# Slack: create an Incoming Webhook, paste URL here. Dev: https://webhook.site (copy unique URL).
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TIMEOUT_SECONDS=5
# WAREHOUSE_ISOLATION_VERIFICATION_ENABLED=false
# WAREHOUSE_ISOLATION_REQUIRE_LOCAL_TRAINING_LAYOUT=false
# WAREHOUSE_ISOLATION_REQUIRED_TABLES=fraud_scores,fraud_alerts,fraud_outcomes,inference_trace,model_registry,tenant_mappers,model_kpi_snapshots,training_uploads
# Optional read replica + analytics warehouse checks (warehouse isolation task merges these)
# READ_REPLICA_DATABASE_URL=
# READ_REPLICA_TABLE_SCHEMA=public
# ANALYTICS_WAREHOUSE_URL=
# ANALYTICS_WAREHOUSE_SCHEMA=public
# ANALYTICS_WAREHOUSE_REQUIRED_TABLES=
# Optional S3 data-plane layout check (per-tenant prefix; requires boto3)
# DATA_PLANE_S3_BUCKET=
# DATA_PLANE_S3_PREFIX_TEMPLATE=
# DATA_PLANE_S3_REQUIRE_OBJECTS=false
# KPI snapshot “stale” alert if no row newer than this (hours)
# MODEL_KPI_SNAPSHOT_MAX_STALE_HOURS=12
# Severe / paging channel (same payload shape as ALERT_WEBHOOK_URL; used for critical)
# PAGING_WEBHOOK_URL=
# Daily audit + optional alert: tenants eligible for fine-tune (does not start training)
# AUTO_TENANT_FINETUNE_SCOUT_ENABLED=false
# AUTO_TENANT_FINETUNE_SCOUT_MIN_ROWS=800
# Calibration promotion gate: require holdout POST /calibration/{id}/holdout-validate before activate
# CALIBRATION_ACTIVATION_REQUIRES_VALIDATION=false
# CALIBRATION_ACTIVATION_MIN_ACCURACY=0.0
# CALIBRATION_ACTIVATION_MIN_AUC=
# Optional: fraud calibration mode (none|platt|isotonic)
# FRAUD_CALIBRATION_METHOD=isotonic
# AUTH_PROVIDER=local
# OIDC_JWKS_URL=
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# SAML_EXPECTED_ISSUER=
# SAML_EXPECTED_AUDIENCE=
# ARTIFACT_ALLOWED_SCHEMES=file,s3
# ARTIFACT_S3_ALLOWED_BUCKETS=
# ARTIFACT_CACHE_TTL_SECONDS=900
# ARTIFACT_CACHE_MAX_FILES=5000
# ARTIFACT_CACHE_MAX_BYTES=2147483648
# ARTIFACT_S3_MAX_RETRIES=4
# ARTIFACT_S3_RETRY_BASE_MS=200
# TENANT_DATA_RETENTION_DAYS=365
# TENANT_ANONYMIZATION_ENABLED=false
# CANARY_ROLLOUT_ENABLED=false
# CANARY_DEFAULT_PERCENT=0
# CANARY_AUTO_STOP_ENABLED=false
# CANARY_AUTO_STOP_WINDOW_HOURS=6
# CANARY_AUTO_STOP_MIN_COMPARED=200
# CANARY_AUTO_STOP_MAX_DISAGREE_RATE=0.25
