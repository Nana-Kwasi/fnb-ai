# =============================================================================
# Production env TEMPLATE — placeholders only. DO NOT put real secrets here.
# Real values go in the Render dashboard env vars (and a local .env that is gitignored).
# =============================================================================
# QUICK STEPS
#   1) Commit model files: models/fraud/*, backend/app/ml/models/care_intent_model.joblib,
#      optionally models/care/care_intent_model.joblib — then git push.
#   2) Backend service: PYTHON_VERSION=3.12.6, set env vars in Render (use these keys).
#   3) Frontend: VITE_API_URL=https://<backend>.onrender.com
#   4) Backend CORS_ALLOWED_ORIGINS=https://<frontend>.onrender.com (replace YOUR_FRONTEND placeholder)
#   5) GGUF optional — MODEL_PATH vs models/llm/<filename>
# =============================================================================

APP_NAME=BankAI Platform
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO
RELEASE_VERSION=1.0.5

PYTHON_VERSION=3.12.6

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://YOUR_FRONTEND_RENDER_URL
EXPOSE_OPENAPI=false

PRODUCTION_POLICY_PROFILE=hardened
ENFORCE_PRODUCTION_HARDENING=true

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

READ_REPLICA_DATABASE_URL=
READ_REPLICA_TABLE_SCHEMA=public
PRODUCTION_REQUIRE_READ_REPLICA=false

REDIS_URL=rediss://default:PASSWORD@HOST:PORT

SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
CARE_JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
PLATFORM_JWT_EXPIRE_MINUTES=720
ADMIN_LEGACY_TOKEN_AUTH=false

AUTH_PROVIDER=local
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
SAML_EXPECTED_ISSUER=
SAML_EXPECTED_AUDIENCE=
PLATFORM_BOOTSTRAP_OWNER_EMAIL=
PLATFORM_BOOTSTRAP_OWNER_PASSWORD=

ARTIFACT_ALLOWED_SCHEMES=file,s3
ARTIFACT_S3_ALLOWED_BUCKETS=your-bucket-name
ARTIFACT_CACHE_TTL_SECONDS=900
ARTIFACT_CACHE_MAX_FILES=5000
ARTIFACT_CACHE_MAX_BYTES=2147483648
ARTIFACT_S3_MAX_RETRIES=4
ARTIFACT_S3_RETRY_BASE_MS=200

AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL=https://<your-account>.r2.cloudflarestorage.com

STRICT_MAPPER_ENFORCEMENT=true
STRICT_TRAINING_GOVERNANCE=true
ALLOW_MODEL_FALLBACK=false
MODEL_FALLBACK_ALLOWLIST_TENANTS=

CANARY_ROLLOUT_ENABLED=true
CANARY_DEFAULT_PERCENT=5
CANARY_AUTO_STOP_ENABLED=true
CANARY_AUTO_STOP_WINDOW_HOURS=6
CANARY_AUTO_STOP_MIN_COMPARED=200
CANARY_AUTO_STOP_MAX_DISAGREE_RATE=0.25

AUTO_ROLLBACK_ENABLED=true
AUTO_ROLLBACK_MODEL_TYPES=fraud,care
AUTO_ROLLBACK_WINDOW_HOURS=24
AUTO_ROLLBACK_MIN_SCORED=300
AUTO_ROLLBACK_MAX_BLOCK_RATE=0.6
AUTO_ROLLBACK_MAX_ALERT_RATE=0.5
AUTO_ROLLBACK_CARE_MAX_ESCALATION_RATE=0.45

SHADOW_SCORING_ENABLED=true
RUN_SCHEDULER_JOBS=false
PRELOAD_FRAUD_MODELS_ON_STARTUP=false
AUTO_PROMOTION_ENABLED=false
AUTO_PROMOTION_WINDOW_HOURS=24
AUTO_PROMOTION_MIN_COMPARED=300
AUTO_PROMOTION_MAX_BLOCK_RATE_DELTA=0.02
AUTO_PROMOTION_MAX_OTP_RATE_DELTA=0.03
AUTO_PROMOTION_MAX_DISAGREE_RATE=0.20
AUTO_PROMOTION_COOLDOWN_HOURS=24
AUTO_PROMOTION_CANDIDATE_MIN_AGE_HOURS=6
AUTO_PROMOTION_MIN_LABELED=100
AUTO_PROMOTION_MIN_PRECISION_DELTA=-0.01

AUTO_CUTOVER_ENABLED=false
AUTO_CUTOVER_DRY_RUN=true
AUTO_CUTOVER_REQUIRE_NO_PRIOR_EXECUTION=true
AUTO_CUTOVER_MODEL_TYPES=fraud,care

TENANT_DATA_RETENTION_DAYS=365
TENANT_ANONYMIZATION_ENABLED=false

ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
PAGING_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME

PRODUCTION_REQUIRE_ALERT_WEBHOOK=true
PRODUCTION_REQUIRE_ANALYTICS_WAREHOUSE=false
ANALYTICS_WAREHOUSE_URL=
ANALYTICS_WAREHOUSE_SCHEMA=public
ANALYTICS_WAREHOUSE_REQUIRED_TABLES=

CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_UPLOADS_ENABLED=true
CLOUDINARY_FOLDER_PREFIX=bankai
CLOUDINARY_STORE_REPORTS=true
CLOUDINARY_STORE_STATEMENTS=true
CLOUDINARY_DELIVERY_TYPE=private

CARE_UPLOADS_ENABLED=true
CARE_UPLOAD_MAX_BYTES=8388608
CARE_UPLOAD_MAX_FILES_PER_DAY=20
CARE_UPLOAD_MAX_BYTES_PER_DAY=41943040
CARE_UPLOAD_DOWNLOAD_TOKEN_TTL_SECONDS=300
MALWARE_SCAN_WEBHOOK_URL=
MALWARE_SCAN_TIMEOUT_SECONDS=6
MALWARE_SCAN_REQUIRE_CLEAN=false

WAREHOUSE_ISOLATION_VERIFICATION_ENABLED=true
WAREHOUSE_ISOLATION_REQUIRE_LOCAL_TRAINING_LAYOUT=false
WAREHOUSE_ISOLATION_REQUIRED_TABLES=fraud_scores,fraud_alerts,fraud_outcomes,inference_trace,model_registry,tenant_mappers,model_kpi_snapshots,training_uploads

DATA_PLANE_S3_BUCKET=
DATA_PLANE_S3_PREFIX_TEMPLATE=
DATA_PLANE_S3_REQUIRE_OBJECTS=false

SENTRY_DSN=https://CHANGE_ME@oXXXX.ingest.us.sentry.io/CHANGE_ME
PROMETHEUS_METRICS_ENABLED=true

REJECT_INFERENCE_ENABLED=true
REJECT_INFERENCE_FRAUD_THRESHOLD=0.80
REJECT_INFERENCE_LEGIT_THRESHOLD=0.40
GNN_EMBEDDINGS_ENABLED=true
BIOMETRICS_ENABLED=true

MODEL_PATH=/models/Phi-3-mini-4k-instruct-q4.gguf
