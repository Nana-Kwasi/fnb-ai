{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "FNB-AI Model Health, Training Runs, Drift & SLA",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Model AUC – Historical Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "fraud_model_auc", "legendFormat": "AUC", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.5,
          "max": 1.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Training Duration (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(model_training_duration_seconds_sum[1h]) / rate(model_training_duration_seconds_count[1h])",
          "legendFormat": "Avg training time",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "title": "Training Runs – Success vs Failure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(model_training_runs_total{status='success'}[6h])",
          "legendFormat": "Success",
          "refId": "A"
        },
        {
          "expr": "increase(model_training_runs_total{status='failure'}[6h])",
          "legendFormat": "Failure",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Fraud Scoring P99 by Tenant (SLA: 500ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(fraud_score_duration_seconds_bucket[5m])) by (le, tenant_id)) * 1000",
          "legendFormat": "p99 {{tenant_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Model Load Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "fraud_model_loaded", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FALLBACK MODE", "color": "red" }, "1": { "text": "MODEL LOADED", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 6,
      "title": "Care P99 Latency (SLA: 5000ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(care_chat_duration_seconds_bucket[5m])) by (le)) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Total Fraud Decisions (24h)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(fraud_score_requests_total[24h])",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "60s",
  "schemaVersion": 38,
  "tags": ["model-health", "training", "sla", "fnb-ai"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "FNB-AI Model Health & Training",
  "uid": "fnbai-model-health",
  "version": 1
}
